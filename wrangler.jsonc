{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitnessmy-staging",
  "main": "backend/index.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "APP_ORIGIN": "https://fitnessmy-staging.hpavel729.workers.dev",
    "GITHUB_CLIENT_ID": "Ov23lian1Br93mfhk8vm",
    "ALLOWED_GITHUB_ID": "43194562",
    "CLOUD_SYNC_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitnessmy-staging",
      "database_id": "49e061b0-2191-453d-891a-abbd8c269e21",
      "migrations_dir": "backend/migrations",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth", "/auth/*"],
  },
  "observability": { "enabled": false },
}
