{
  "name": "lenta",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Lenta — offline-first personal PWA for nutrition, training and health",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "check:backend": "tsc -p tsconfig.backend.json",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:storage": "playwright test --config playwright.storage.config.ts",
    "seed:exercises": "node scripts/build-exercises.mjs",
    "seed:images": "node scripts/fetch-exercise-images.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "check:spec": "node scripts/check-spec.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:release": "node scripts/verify-release.mjs",
    "check:release:cloud": "node scripts/verify-release.mjs --cloud"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^23.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-router-dom": "6.30.6",
    "recharts": "^2.12.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "wrangler": "4.156.1"
  }
}
